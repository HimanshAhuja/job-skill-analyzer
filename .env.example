# Local PostgreSQL + pgvector started with "npm run db:start" (PGlite, no install needed).
# For Docker / a cloud database, replace this with that database's connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
PG_POOL_MAX=5
# Secret used to sign login sessions - any long random string (e.g. output of: openssl rand -hex 32)
SESSION_SECRET=replace-with-a-long-random-string
